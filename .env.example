# One deployment = one region. Copy to .env for local work. Never commit real values.
APP_ENV=dev                     # dev | staging | prod
REGION=ca-qc                    # ca-qc (Canadian tenants, Quebec) | us (US tenants)
# Optional. Defaults from REGION (ca-qc→CA, us→US). Staging/prod refuse a mismatch.
# DATA_COUNTRY=CA
PRODUCT_NAME=PII
PRODUCT_DISPLAY_NAME=PII by Punjab Insurance
APP_ORIGIN=https://app.punjabinsurance.net
PORT=3000
LOG_LEVEL=info

# Owner/migration role (runs migrations only, never used by the running API)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pii
# Runtime role: app_runtime (NOBYPASSRLS). The API runs as this.
APP_DATABASE_URL=postgres://app_runtime:change-me@127.0.0.1:5432/pii
# Login-only role: app_auth (can look up users, nothing else)
AUTH_DATABASE_URL=postgres://app_auth:change-me@127.0.0.1:5432/pii

# DEV ONLY. Header-based sign-in for local work. The API refuses to start with this on outside APP_ENV=dev.
DEV_AUTH=false

# Local encryption keys (dev only). Production uses the cloud KMS in the tenant's region.
# Format: id:base64key,id2:base64key2  (32 random bytes each)
LOCAL_KEYS=
LOCAL_KEY_SECRET=
SEED_STARTER_PIPELINE=
CURRENT_KEY_ID=

# Google sign-in (sign-in scopes only: openid email profile). Leave blank to use DEV_AUTH locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters; signs the short-lived sign-in flow cookie.
COOKIE_SECRET=
PRIVACY_EMAIL=privacy-officer@punjabinsurance.com
POLICY_URL=https://app.punjabinsurance.net/privacy
# Extra origins allowed to make cookie-authenticated writes, comma separated (the Chrome extension later).
EXTENSION_ORIGINS=

# Optional AI (off unless a company admin enables it in Settings). Data leaves the region when used — counsel gate for CA.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=claude-sonnet-4-5
