{
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.punjabinsurance.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "nav-icon.png",
        "icon-32.png",
        "icons/*.svg"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "content_script_matches": [
    [
      "https://mail.google.com/*"
    ]
  ]
}
