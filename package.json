{
  "name": "pii-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PII: Gmail-native CRM + LMS for Punjab Insurance Agency Inc (app.punjabinsurance.co)",
  "engines": { "node": ">=22.18" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @pii/web",
    "test": "node --test --test-concurrency=1 \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "test:isolation": "bash tests/isolation/run.sh",
    "test:smoke": "bash tests/uat/run_smoke.sh",
    "test:perf": "bash tests/perf/run.sh",
    "test:security": "python3 tests/security/scan_pii_leaks.py",
    "migrate": "node packages/db/src/cli.ts migrate",
    "dev": "node --watch apps/api/src/main.ts",
    "start": "node apps/api/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.9.0"
  }
}
